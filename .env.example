# Gateway connections
NOMAD_GATEWAY_URL=http://localhost:8081
NOMAD_GATEWAY_KEY=your-nomad-gateway-key
ADGUARD_GATEWAY_URL=http://localhost:8082
ADGUARD_GATEWAY_KEY=your-adguard-gateway-key
CF_GATEWAY_URL=http://localhost:8083
CF_GATEWAY_KEY=your-cf-gateway-key
MINECRAFT_GATEWAY_URL=http://localhost:8084
MINECRAFT_GATEWAY_KEY=your-minecraft-gateway-key
CURSEFORGE_GATEWAY_URL=http://localhost:8085
CURSEFORGE_GATEWAY_KEY=your-curseforge-gateway-key
VAULT_GATEWAY_URL=http://localhost:8086
VAULT_GATEWAY_KEY=your-vault-gateway-key

# Logging
LOG_LEVEL=info

# Nomad defaults
NOMAD_DEFAULT_DATACENTER=dc1
NOMAD_DEFAULT_NODE_POOL=default

# Infrastructure
NFS_BASE_PATH=/mnt/fast/minecraft
MC_PUBLIC_DOMAIN=mc.example.com
MC_PUBLIC_IP=203.0.113.1
CF_ZONE_NAME=example.com

# Security (comma-separated additional artifact sources)
ARTIFACT_ALLOWLIST=

# Data
DATA_DIR=/data
ITZG_DOCS_REFRESH_INTERVAL=24h
